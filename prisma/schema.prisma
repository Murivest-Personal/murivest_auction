// Prisma schema — LOCAL development/demo store for
// auctions.murivest.com. Mirrors the Supabase tables in
// /supabase/migrations (auction_bids, auction_inquiries,
// property_comments). In production with SUPABASE_URL +
// SUPABASE_SERVICE_ROLE_KEY configured, the API routes call the
// Postgres RPCs instead and this store is bypassed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Guest bid registrations (mirrors public.auction_bids).
/// consent_fee + consent_terms + timestamps + consent text
/// versions are stored with every record (user requirement:
/// the buyer accepts the 2% fee and the T&Cs, all in the DB).
model AuctionBid {
  id                String   @id @default(uuid())
  propertySanityId  String
  propertySlug      String
  propertyTitle     String
  propertyMarket    String
  bidderName        String
  bidderEmail       String
  bidderPhone       String
  bidAmount         Float
  bidCurrency       String   @default("KES")
  consentTerms      Boolean
  consentFee        Boolean
  termsConsentAt    DateTime?
  feeConsentAt      DateTime?
  depositAcknowledged Boolean @default(true)
  termsVersion      String?
  feeTermsVersion   String?
  status            String   @default("pending")
  ipHash            String?
  userAgent         String?
  referrer          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propertySanityId])
  @@index([bidderEmail, createdAt])
  @@index([status, createdAt])
}

/// Buyer inquiries (mirrors public.auction_inquiries).
model AuctionInquiry {
  id               String   @id @default(uuid())
  propertySanityId String?
  propertySlug     String?
  propertyTitle    String?
  fullName         String
  email            String
  phone            String?
  country          String?
  buyerType        String?
  budgetMin        Float?
  budgetMax        Float?
  currency         String   @default("KES")
  financingMethod  String?
  inquiryType      String   @default("general")
  message          String?
  status           String   @default("new")
  consentPrivacy   Boolean  @default(false)
  consentAt        DateTime?
  ipHash           String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertySanityId])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

/// Property comments, moderated before publication (mirrors
/// public.property_comments).
model PropertyComment {
  id               String   @id @default(uuid())
  propertySanityId String
  propertySlug     String
  authorName       String
  authorEmail      String
  body             String
  moderationStatus String   @default("pending")
  isPublic         Boolean  @default(false)
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertySanityId, moderationStatus])
}

/* ============================================================
   Buyer qualification system + confidential document vault
   (mirrors the Supabase tables in 0014_buyer_qualification_vault.sql)
   ============================================================ */

/// Buyer registrations — the 10-point qualification capture.
/// Classification follows the 8-stage ladder in lib/buyer/qualification.
/// Proof-of-funds files are stored OUTSIDE public/ (lib/private-store)
/// and are only ever streamed through authenticated routes.
model BuyerRegistration {
  id                String   @id @default(uuid())
  /// Sha-256 of the access code shown once at registration. The
  /// buyer signs in with email + access code.
  accessCodeHash    String
  buyerType         String   // individual | company | family_office | institutional
  fullName          String
  email             String
  phone             String
  countryOfResidence String
  taxJurisdiction   String
  idType            String   // passport | national_id | company_registration | tax_pin
  idNumber          String
  purchasingEntityName       String?
  purchasingEntityJurisdiction String?
  /// JSON string: [{ name, share }] — beneficial owners (corporate buyers).
  beneficialOwners  String?
  budgetMin         Float?
  budgetMax         Float?
  budgetCurrency    String   @default("USD")
  preferredCountry  String   // kenya | uk | both
  preferredLocations String?
  /// JSON string array of asset classes.
  assetClasses      String
  fundingPreference String   // cash | financing | mixed
  pofType           String?  // bank_statement | lender_letter | other
  pofFileName       String?
  pofStoredPath     String?  // private store key — never a public URL
  pofFileSize       Int?
  pofMimeType       String?
  pofSha256         String?
  pofUploadedAt     DateTime?
  lenderName        String?
  acquisitionTimeline String  // immediate | within-3-months | 3-6-months | 6-12-months | exploring
  classification    String   @default("registration-pending")
  classificationNote String?
  consentTerms      Boolean  @default(false)
  consentAt         DateTime?
  termsVersion      String?
  ipHash            String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([classification, updatedAt])
  @@index([email])
}

/// NDA acceptances — one per buyer per property, with timestamp
/// and the terms version the buyer accepted.
model NdaAcceptance {
  id            String   @id @default(uuid())
  buyerId       String
  propertySlug  String
  termsVersion  String
  acceptedAt    DateTime @default(now())
  ipHash        String?
  userAgent     String?

  @@unique([buyerId, propertySlug])
  @@index([propertySlug, acceptedAt])
}

/// Confidential data room documents (metadata only — file bytes live
/// in the private store / private storage bucket, keyed by version).
model VaultDocument {
  id            String   @id @default(uuid())
  propertySlug  String
  title         String
  category      String   // legal_pack | title | tenancy | searches | valuation | addendum | report | other
  allowDownload Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertySlug])
}

/// Immutable versions: every upload appends a row. The current
/// version is the newest one not superseded; expired versions are
/// blocked for buyers until replaced.
model VaultDocumentVersion {
  id           String    @id @default(uuid())
  documentId   String
  version      Int
  fileName     String
  storedPath   String    // private store key — never a public URL
  fileSize     Int
  mimeType     String    @default("application/pdf")
  sha256       String?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())
  notes        String?
  expiresAt    DateTime?
  supersededAt DateTime?

  @@index([documentId, version])
}

/// Per-property authorisation. A qualified, NDA-signed buyer still
/// needs an active grant for each property individually.
model VaultAccessGrant {
  id            String    @id @default(uuid())
  buyerId       String
  propertySlug  String
  grantedAt     DateTime  @default(now())
  grantedBy     String
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  @@index([propertySlug])
  @@index([buyerId])
}

/// Buyer-visible notifications — addenda and new versions for
/// properties the buyer has access to.
model VaultNotification {
  id           String    @id @default(uuid())
  buyerId      String
  propertySlug String
  documentId   String?
  title        String
  message      String
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([buyerId, readAt])
}

/// Full audit trail: nda_accepted, access_requested, view, download,
/// grant, revoke, version_published, pof_viewed, denied.
model VaultAccessLog {
  id           String   @id @default(uuid())
  buyerId      String?
  propertySlug String?
  documentId   String?
  versionId    String?
  action       String
  details      String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([propertySlug, createdAt])
  @@index([buyerId, createdAt])
}
