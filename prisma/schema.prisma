// Prisma schema — LOCAL development/demo store for
// auctions.murivest.com. Mirrors the Supabase tables in
// /supabase/migrations. In production with SUPABASE_URL +
// SUPABASE_SERVICE_ROLE_KEY configured, the API routes call the
// Postgres RPCs instead and this store is bypassed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // runtime → pooler:6543
  directUrl = env("DIRECT_URL")        // migrate/db push → session:5432
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Buyer inquiries (mirrors public.auction_inquiries).
model AuctionInquiry {
  id               String   @id @default(uuid())
  propertySanityId String?
  propertySlug     String?
  propertyTitle    String?
  fullName         String
  email            String
  phone            String?
  country          String?
  buyerType        String?
  budgetMin        Float?
  budgetMax        Float?
  currency         String   @default("KES")
  financingMethod  String?
  inquiryType      String   @default("general")
  message          String?
  status           String   @default("new")
  consentPrivacy   Boolean  @default(false)
  consentAt        DateTime?
  ipHash           String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertySanityId])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

/// Property comments, moderated before publication (mirrors
/// public.property_comments).
model PropertyComment {
  id               String   @id @default(uuid())
  propertySanityId String
  propertySlug     String
  authorName       String
  authorEmail      String
  body             String
  moderationStatus String   @default("pending")
  isPublic         Boolean  @default(false)
  ipHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([propertySanityId, moderationStatus])
}

/* ============================================================
   Client accounts — registration & qualification, saved lots,
   account bids, notification settings, audit trail.
   (replaces the former buyer portal / data room store)
   ============================================================ */

/// Client account registrations — the 10-point qualification
/// capture. Classification follows the 8-stage ladder in
/// lib/buyer/qualification. Proof-of-funds files are stored
/// OUTSIDE public/ (lib/private-store) and are only ever streamed
/// through authenticated routes.
model BuyerRegistration {
  @@map("buyer_registrations")
  id                String   @id @default(uuid())
  /// Sha-256 of the access code shown once at registration. The
  /// client signs in with email + access code.
  accessCodeHash    String
  buyerType         String   // individual | company | family_office | institutional
  fullName          String
  email             String
  phone             String
  countryOfResidence String
  taxJurisdiction   String
  idType            String   // passport | national_id | company_registration | tax_pin
  idNumber          String
  purchasingEntityName       String?
  purchasingEntityJurisdiction String?
  /// JSON string: [{ name, share }] — beneficial owners (corporate buyers).
  beneficialOwners  String?
  budgetMin         Float?
  budgetMax         Float?
  budgetCurrency    String   @default("USD")
  preferredCountry  String   // kenya | uk | both
  preferredLocations String?
  /// JSON string array of asset classes.
  assetClasses      String
  fundingPreference String   // cash | financing | mixed
  pofType           String?  // bank_statement | lender_letter | other
  pofFileName       String?
  pofStoredPath     String?  // private store key — never a public URL
  pofFileSize       Int?
  pofMimeType       String?
  pofSha256         String?
  pofUploadedAt     DateTime?
  lenderName        String?
  acquisitionTimeline String  // immediate | within-3-months | 3-6-months | 6-12-months | exploring
  classification    String   @default("registration-pending")
  classificationNote String?
  consentTerms      Boolean  @default(false)
  consentAt         DateTime?
  termsVersion      String?
  ipHash            String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /* Notification settings (account profile) */
  notifyNewLots     Boolean  @default(true)
  notifyOffMarket   Boolean  @default(true)
  notifyBidUpdates  Boolean  @default(true)

  @@index([classification, updatedAt])
  @@index([email])
}

/// Lots saved or liked by a signed-in account. kind is "save"
/// (bookmark) or "like". Share needs no row — it is a client-side
/// action on the lot page.
model SavedLot {
  id           String   @id @default(uuid())
  buyerId      String
  propertySlug String
  kind         String   // save | like
  createdAt    DateTime @default(now())

  @@unique([buyerId, propertySlug, kind])
  @@index([buyerId, kind, createdAt])
}

/// Bids submitted from property pages — exclusive to registered
/// (signed-in) accounts. Consents are stored with timestamps and
/// text versions, exactly as with the former guest registrations.
model BuyerBid {
  id                String   @id @default(uuid())
  reference         String   @unique
  buyerId           String
  propertySanityId  String?
  propertySlug      String
  propertyTitle     String
  propertyMarket    String
  bidAmount         Float
  bidCurrency       String   @default("KES")
  consentTerms      Boolean  @default(false)
  consentFee        Boolean  @default(false)
  termsConsentAt    DateTime?
  feeConsentAt      DateTime?
  termsVersion      String?
  feeTermsVersion   String?
  /// submitted | acknowledged | routed | declined | withdrawn | superseded
  status            String   @default("submitted")
  statusNote        String?
  ipHash            String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([propertySlug, createdAt])
  @@index([status, createdAt])
}

/// Generic audit trail for the back office: bid_submitted,
/// bid_status_changed, pof_viewed, classification_changed,
/// account_setting_changed.
model AuditLog {
  id           String   @id @default(uuid())
  buyerId      String?
  propertySlug String?
  bidId        String?
  action       String
  details      String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([buyerId, createdAt])
}

/// NDA acceptances — one per buyer per property, timestamped.
model NdaAcceptance {
  id            String   @id @default(uuid())
  buyerId       String
  propertySlug  String
  termsVersion  String
  acceptedAt    DateTime @default(now())
  ipHash        String?
  userAgent     String?

  @@unique([buyerId, propertySlug])
  @@index([propertySlug, acceptedAt])

  @@map("nda_acceptances")
}

/// Data room documents (metadata).
model VaultDocument {
  id            String   @id @default(uuid())
  propertySlug  String
  title         String
  category      String
  allowDownload Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertySlug])

  @@map("vault_documents")
}

/// Immutable document versions. File bytes live in the PRIVATE storage bucket.
model VaultDocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  version      Int
  fileName     String
  storagePath  String
  fileSize     Int
  mimeType     String   @default("application/pdf")
  sha256       String?
  uploadedBy   String
  uploadedAt   DateTime @default(now())
  notes        String?
  expiresAt    DateTime?
  supersededAt DateTime?

  @@unique([documentId, version])
  @@index([documentId, version])

  @@map("vault_document_versions")
}

/// Per-property access grants.
model VaultAccessGrant {
  id            String   @id @default(uuid())
  buyerId       String
  propertySlug  String
  grantedAt     DateTime @default(now())
  grantedBy     String
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  @@index([propertySlug, grantedAt])
  @@index([buyerId, grantedAt])

  @@map("vault_access_grants")
}

/// Buyer notifications for data room updates.
model VaultNotification {
  id           String   @id @default(uuid())
  buyerId      String
  propertySlug String
  documentId   String?
  title        String
  message      String
  createdAt    DateTime @default(now())
  readAt       DateTime?

  @@index([buyerId, createdAt])

  @@map("vault_notifications")
}

/// Audit log for data room access.
model VaultAccessLog {
  id           String   @id @default(uuid())
  buyerId      String?
  propertySlug String?
  documentId   String?
  versionId    String?
  action       String
  details      String?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([propertySlug, createdAt])
  @@index([buyerId, createdAt])

  @@map("vault_access_logs")
}
